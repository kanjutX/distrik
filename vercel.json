{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/forum/threads/:id/posts",
      "destination": "/api/forum?r=posts&id=:id"
    },
    {
      "source": "/api/forum/threads/:id",
      "destination": "/api/forum?r=thread&id=:id"
    },
    {
      "source": "/api/forum/threads",
      "destination": "/api/forum?r=threads"
    },
    {
      "source": "/api/forum/posts/:id",
      "destination": "/api/forum?r=post&id=:id"
    },
    {
      "source": "/api/members/:id",
      "destination": "/api/members?r=one&id=:id"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/admin/announcements/:id",
      "destination": "/api/admin?r=announcement&id=:id"
    },
    {
      "source": "/api/admin/announcements",
      "destination": "/api/admin?r=announcements"
    },
    {
      "source": "/api/admin/titles/:id",
      "destination": "/api/admin?r=title&id=:id"
    },
    {
      "source": "/api/admin/titles",
      "destination": "/api/admin?r=titles"
    },
    {
      "source": "/api/admin/settings",
      "destination": "/api/admin?r=settings"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/admin?r=users"
    },
    {
      "source": "/api/titles/:action",
      "destination": "/api/titles?action=:action"
    },
    {
      "source": "/api/stats",
      "destination": "/api/public?r=stats"
    },
    {
      "source": "/api/settings-public",
      "destination": "/api/public?r=settings"
    },
    {
      "source": "/api/announcements",
      "destination": "/api/public?r=announcements"
    },
    {
      "source": "/api/avatar",
      "destination": "/api/profile?r=avatar"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.public.blob.vercel-storage.com https://*.googleusercontent.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
